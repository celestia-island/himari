{
  "comments": { "lineComment": "%" },
  "brackets": [["[", "]"], ["(", ")"], ["{", "}"]],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "{", "close": "}" },
    { "open": "\\begin{bmatrix}", "close": " \\end{bmatrix}", "notIn": ["string"] }
  ],
  "surroundingPairs": [["[", "]"], ["(", ")"], ["{", "}"]],
  "folding": { "markers": { "start": "^\\s*decl\\s*\\{", "end": "^\\s*\\}" } }
}
