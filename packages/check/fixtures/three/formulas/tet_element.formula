% 3D 四面体单元（3 阶逆 / 4 阶行列式）：体积 = det(J)/6，形函数梯度要 J⁻¹。
% 这是 inv 从 2 阶放开到 3 阶的理由 —— 3D 等参变换的刚需。
decl {
    x_1 : node_x [m];
    x_2 : node_x [m];
    x_3 : node_x [m];
    x_4 : node_x [m];
    y_1 : node_y [m];
    y_2 : node_y [m];
    y_3 : node_y [m];
    y_4 : node_y [m];
    z_1 : node_z [m];
    z_2 : node_z [m];
    z_3 : node_z [m];
    z_4 : node_z [m];
}
J3 = [ x_2 - x_1, x_3 - x_1, x_4 - x_1 ;
  y_2 - y_1, y_3 - y_1, y_4 - y_1 ;
  z_2 - z_1, z_3 - z_1, z_4 - z_1 ]
vol = det(J3) / 6
J3_inv = inv(J3)
