% 复数车道覆盖：每一个 `__c_*` 算子都必须真的被发射过并被值层对照过。
% 覆盖清单：abs arg conj re im exp ln sin cos tan sinh cosh tanh + 幂（含负实底整数幂）
decl {
    u : real_part [1];
    v : imaginary_part [1];
}
z = u + j * v
z_abs = abs(z)
z_arg = arg(z)
z_conj = conj(z)
z_re = re(z)
z_im = im(z)
z_exp = exp(z)
z_ln = ln(z)
z_sin = sin(z)
z_cos = cos(z)
z_tan = tan(z)
z_sinh = sinh(z)
z_cosh = cosh(z)
z_tanh = tanh(z)
z_pow3 = (u - 1) ^ 3 + j * v
z_sqrt = z ^ (1 / 2)
