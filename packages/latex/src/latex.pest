// LaTeX subset (candidate front end A of this spike).
//
// Design points (not "as long as it runs" — every one of them is a trade-off over
// "explainability/determinism"):
//   1. Only the math-mode subset is accepted: no \begin{align}, no \left(, no macro definitions,
//      no catcode.
//   2. Semantics must come from the leading `decl { ... }` declaration block: every symbol needs
//      a dimension, and no glyph inference is done at all.
//   3. Implicit multiplication is allowed, but **only unambiguous under LaTeX's single-letter /
//      single-command identifier system**
//      (`xy` is naturally x·y in LaTeX; multi-letter names must be written as commands, such as
//      \alpha).
//   4. Functions must carry explicit parentheses: \exp(x). `\exp x` and `\sin^2 x` are always
//      rejected — they are ambiguous.

// Isomorphic to the matlab surface: a newline is a first-class separator and is not part of
// implicit whitespace.
WHITESPACE = _{ " " | "\t" }
NEWLINE    = _{ "\r" | "\n" }
// End of a line = an optional end-of-line comment + a newline (the newline after a comment line
// is consumed here and does not fall through).
LINE_END   = _{ COMMENT? ~ NEWLINE }
COMMENT    = _{ "%" ~ (!"\n" ~ ANY)* }

// The file header allows `use "relative/path"`: reuse a formula library across files
// (parsing only collects it; the IO lives in the loader lane)
file        = { SOI ~ LINE_END* ~ (use_stmt ~ LINE_END*)* ~ decl_block? ~ formula ~ (formula_sep ~ formula)* ~ formula_sep? ~ (LINE_END | COMMENT)* ~ EOI }
use_stmt    = { "use" ~ "\"" ~ use_path ~ "\"" }
use_path    = @{ (!"\"" ~ !NEWLINE ~ ANY)+ }
formula_sep = { ";" ~ LINE_END* | LINE_END+ }
decl_block  = { "decl" ~ "{" ~ LINE_END* ~ (decl ~ LINE_END*)+ ~ "}" }
decl        = { ident ~ ":" ~ ident ~ unit_bracket? ~ ";" }
unit_bracket = { "[" ~ unit ~ "]" }
unit        = { unit_atom ~ (("/" | "*") ~ unit_atom)* }
unit_atom   = { unit_name ~ ("^" ~ unit_pow)? }
// Unit exponent: integers are written directly; **rational numbers must be parenthesized**
// (`s^(-1/2)`). Without parentheses the `/` inside the exponent cannot be told apart from the
// division sign of the unit string — rejected at the syntax level, so that a message like
// "unknown unit 2" does not hide the real cause.
unit_pow    = { "(" ~ unit_frac ~ ")" | "(" ~ unit_exp ~ ")" | unit_exp }
unit_frac   = @{ "-"? ~ ASCII_DIGIT+ ~ "/" ~ ASCII_DIGIT+ }
// `1` is the explicit dimensionless unit (quantities such as gain / count / mole fraction must
// be declarable)
unit_name   = @{ ASCII_ALPHA+ | "1" | "\u{03a9}" | ("\u{00b5}" | "\u{03bc}") ~ ASCII_ALPHA* }
unit_exp    = @{ "-"? ~ ASCII_DIGIT+ }

// Federated formula block: one or more formulas; a later formula may reference an earlier name
// (subst inlining).
formula     = { LINE_END* ~ (assign | expr) }
assign      = { ident ~ "=" ~ LINE_END* ~ expr }

expr        = { term ~ (add_op ~ LINE_END* ~ term)* }
add_op      = { "+" | "-" | "\u{2212}" }   // includes the real U+2212 minus sign
// Juxtaposition multiplication (implicit) must be **on the same line**: a cross-line one swallows the next formula.
// An explicit \cdot / · / × may cross lines.
term        = { unary ~ ( (LINE_END* ~ mul_op ~ LINE_END* ~ unary) | (!add_op ~ !LINE_END ~ unary) )* }
// Multiplication and division are at the same precedence, left-associative. Both `/` and `\div`
// are true division (the lowerer tells them apart by the source text, see lower_term).
// Previously there was **no division operator** here — the LaTeX surface only knew
// `\frac{a}{b}`, and `a / b` was a straight syntax error.
// That was "throwing out the baby with the bathwater": `/` is the most ordinary way to write
// division and there is no reason to reject it.
mul_op      = { "\\cdot" | "*" | "/" | "\\div" | "\u{00b7}" | "\u{00d7}" | "\u{2215}" }   // · × ⁄
unary       = { LINE_END* ~ add_op? ~ LINE_END* ~ power }
power       = { atom ~ ("^" ~ atom)* }   // a superscript T is reserved for transpose (lowering special case)

atom        = { pfrac | frac | sqrt | func | op_sum | op_int | nabla | mat_env | group | brace | number | mathrm | symbol }
// The **only** legal way to write a multi-letter identifier: `\mathrm{sigma_0}`.
// Bare `sigma_0` would be read by LaTeX as s·i·g·m·a₀, and the round trip would break.
mathrm      = { "\\mathrm" ~ "{" ~ ident ~ "}" }
// \frac{\partial u}{\partial x} → Deriv (tried before a plain frac)
pfrac       = { "\\frac" ~ "{" ~ "\\partial" ~ expr ~ "}" ~ "{" ~ "\\partial" ~ ident ~ "}" }
// ∇ and Δ/∇²
// ∇ prefix form: the following power is taken directly as the operand
// (\nabla u → Grad, \nabla^2 u → Laplacian)
nabla       = { ("\\nabla" | "\u{2207}") ~ nabla_pow? ~ power }
nabla_pow   = { "^" ~ "2" }
// \sum_{i=a}^{b} body / \int_a^b body (the bounds go into braces or are a bare atom)
op_sum      = { ("\\sum" | "\u{2211}") ~ "_" ~ "{" ~ ident ~ "=" ~ expr ~ "}" ~ "^" ~ "{" ~ expr ~ "}" ~ power }
// The trailing `\, d var` of ∫ is the to_latex rendering — accepting it is what closes the
// round trip
op_int      = { ("\\int" | "\u{222b}") ~ "_" ~ (brace | atom) ~ "^" ~ (brace | atom) ~ power ~ (("\\," )? ~ "d" ~ ident)? }
mat_env     = { "\\begin{bmatrix}" ~ LINE_END* ~ mrow ~ (mrow_sep ~ mrow)* ~ LINE_END* ~ "\\end{bmatrix}" }
// bmatrix row separator = LaTeX's \\ or a newline (hand-written habits take both)
mrow_sep    = _{ ("\\\\" ~ LINE_END*) | LINE_END+ }
mrow        = { mcell ~ (LINE_END* ~ "&" ~ LINE_END* ~ mcell)* }
mcell       = { dots | expr }
dots        = @{ "\\cdots" | "\\vdots" | "\\ddots" | "…" | "⋯" | "…" }
frac        = { "\\frac" ~ brace ~ brace }
sqrt        = { "\\sqrt" ~ brace }
brace       = { "{" ~ LINE_END* ~ expr ~ LINE_END* ~ "}" }
group       = { "(" ~ expr ~ ")" }
func        = { (func_name | func_op) ~ "(" ~ expr ~ ("," ~ expr)* ~ ")" }
func_name   = @{ "\\" ~ ("sinh" | "cosh" | "tanh" | "sin" | "cos" | "tan" | "exp" | "ln" | "log" | "min" | "max" | "det") }
// Operators without a fixed glyph (complex abs/arg/conj/re/im) are spelled
// \operatorname{...}: a form like `|z|` is ambiguous with matrix/determinant delimiters, so this
// dialect never accepts it.
func_op     = { "\\operatorname" ~ "{" ~ ident ~ "}" }

number      = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)? }

symbol      = ${ (greek | single) ~ sub? }
greek       = @{ ("\\" ~ ("alpha" | "beta" | "gamma" | "delta" | "epsilon" | "eta" | "theta" | "kappa" | "lambda" | "mu" | "nu" | "xi" | "pi" | "rho" | "sigma" | "tau" | "phi" | "chi" | "psi" | "omega" | "Delta" | "Omega" | "Gamma" | "Sigma" | "Pi")) | ("\u{03b1}" | "\u{03b2}" | "\u{03b3}" | "\u{03b4}" | "\u{03b5}" | "\u{03b7}" | "\u{03b8}" | "\u{03ba}" | "\u{03bb}" | "\u{03bc}" | "\u{03bd}" | "\u{03be}" | "\u{03c0}" | "\u{03c1}" | "\u{03c3}" | "\u{03c4}" | "\u{03c6}" | "\u{03c7}" | "\u{03c8}" | "\u{03c9}" | "\u{0394}" | "\u{03a9}" | "\u{0393}" | "\u{03a3}" | "\u{03a0}") }
single      = @{ ASCII_ALPHA }
// Subscript triage (2026-11-23 decision): **braces + letters/commas = an index** (a_{i,j},
// a_{i}); a bare subscript is always part of the name (E_a, i_0) — compatible with multi-character
// naming under the single-letter system.
sub         = _{ sub_idx | sub_name }
sub_idx     = { "_" ~ "{" ~ sub_body ~ "}" }
sub_name    = { "_" ~ sub_body }
sub_body    = @{ ASCII_ALPHANUMERIC+ ~ ("," ~ ASCII_ALPHANUMERIC+)* }

ident       = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }